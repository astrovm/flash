diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 818d180f..aaadf655 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -168,3 +168,28 @@ if(${PROJECT}_INSTALL)
 endif()
 
 re3_platform_target(${EXECUTABLE} INSTALL)
+
+if(EMSCRIPTEN)
+    # The browser build: WebGL 2 through Emscripten's GLFW, Emscripten's OpenAL,
+    # and a main loop that hands each frame back to the browser (Asyncify).
+    # The page starts the game itself once the data files are in place.
+    target_include_directories(${EXECUTABLE} SYSTEM AFTER PRIVATE
+        "${PROJECT_SOURCE_DIR}/vendor/openal-soft/include")
+    set(${PROJECT}_WEB_FLAGS
+        -lopenal
+        -sASYNCIFY=1
+        -sASYNCIFY_STACK_SIZE=65536
+        -sALLOW_MEMORY_GROWTH=1
+        -sINITIAL_MEMORY=268435456
+        -sSTACK_SIZE=1048576
+        -sFORCE_FILESYSTEM=1
+        -sMODULARIZE=1
+        -sEXPORT_NAME=createRe3Module
+        -sINVOKE_RUN=0
+        -sEXIT_RUNTIME=0
+        -sEXPORTED_RUNTIME_METHODS=FS,callMain,ccall
+        -lidbfs.js
+    )
+    target_link_options(${EXECUTABLE} PRIVATE ${${PROJECT}_WEB_FLAGS})
+    set_target_properties(${EXECUTABLE} PROPERTIES SUFFIX ".js")
+endif()
