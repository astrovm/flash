diff --git a/src/core/CdStreamPosix.cpp b/src/core/CdStreamPosix.cpp
index bc9129eb..fb5613e0 100644
--- a/src/core/CdStreamPosix.cpp
+++ b/src/core/CdStreamPosix.cpp
@@ -122,9 +122,34 @@ int _gdwCdStreamFlags;
 
 void *CdStreamThread(void* channelId);
 
+#ifdef __EMSCRIPTEN__
+// The browser has no threads here, and the "disc" is a virtual filesystem
+// with no seek time to hide, so reads run straight away on the main thread.
+static void
+CdStreamPerformReadSync(CdReadInfo *pChannel)
+{
+	pChannel->bReading = true;
+	if ( pChannel->nStatus == STREAM_NONE )
+	{
+		size_t requested = (size_t)pChannel->nSectorsToRead * (size_t)CDSTREAM_SECTOR_SIZE;
+		lseek(pChannel->hFile, (size_t)pChannel->nSectorOffset * (size_t)CDSTREAM_SECTOR_SIZE, SEEK_SET);
+		ssize_t got = read(pChannel->hFile, pChannel->pBuffer, requested);
+		if ( got == -1 || (size_t)got != requested )
+			pChannel->nStatus = STREAM_ERROR;
+	}
+	pChannel->nSectorsToRead = 0;
+	pChannel->bLocked = 0;
+	pChannel->bReading = false;
+}
+#endif
+
 void
 CdStreamInitThread(void)
 {
+#ifdef __EMSCRIPTEN__
+	gCdStreamThreadStatus = 0;
+	return;
+#endif
 	int status;
 #ifndef ONE_THREAD_PER_CHANNEL
 	gChannelRequestQ.items = (int32 *)calloc(gNumChannels + 1, sizeof(int32));
@@ -268,6 +293,12 @@ GetGTA3ImgSize(void)
 void
 CdStreamShutdown(void)
 {
+#ifdef __EMSCRIPTEN__
+	gCdStreamThreadStatus = 2;
+	free(gpReadInfo);
+	gpReadInfo = nil;
+	return;
+#endif
     // Destroying semaphores and free(gpReadInfo) will be done at threads
 #ifndef ONE_THREAD_PER_CHANNEL
 	gCdStreamThreadStatus = 2;
@@ -316,7 +347,9 @@ CdStreamRead(int32 channel, void *buffer, uint32 offset, uint32 size)
 	pChannel->pBuffer = buffer;
 	pChannel->bLocked = 0;
 
-#ifndef ONE_THREAD_PER_CHANNEL
+#ifdef __EMSCRIPTEN__
+	CdStreamPerformReadSync(pChannel);
+#elif !defined ONE_THREAD_PER_CHANNEL
 	AddToQueue(&gChannelRequestQ, channel);
 	if ( sem_post(gCdStreamSema) != 0 )
 		printf("Signal Sema Error\n");
