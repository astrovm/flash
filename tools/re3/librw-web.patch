 	glGetFloatv(GL_MAX_TEXTURE_MAX_ANISOTROPY_EXT, &gl3Caps.maxAnisotropy);
+#endif
 
 	if(gl3Caps.gles){
 		if(gl3Caps.glversion >= 30)
+#ifdef __EMSCRIPTEN__
+			shaderDecl = shaderDecl300es;
