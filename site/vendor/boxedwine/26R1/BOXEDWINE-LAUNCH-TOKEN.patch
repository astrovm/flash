diff --git a/source/sdl/emscripten/mainloop.cpp b/source/sdl/emscripten/mainloop.cpp
index fa97b32..0bc4eb5 100644
--- a/source/sdl/emscripten/mainloop.cpp
+++ b/source/sdl/emscripten/mainloop.cpp
@@ -18,6 +18,7 @@
 
 #ifdef __EMSCRIPTEN__
 #include <emscripten/emscripten.h>
+#include <map>
 #include "boxedwine.h"
 #include "knativesystem.h"
 #include "knativewindowbridge.h"
@@ -30,6 +31,17 @@ static U32 pendingTermination;
 static U32 launchResult;
 static U32 pendingLaunchToken;
 
+// Wine routes a guest CreateProcessW call for a new top-level process
+// through the single shared wineserver, so the resulting process's OS-level
+// parent is wineserver, not the application that asked for it: walking
+// parentId (see boxedwineNativeLaunchToken) cannot recover which launch a
+// child belongs to. Wine always execve()s "/bin/wine <target.exe>", passing
+// the target Windows executable as one of the new argv entries (the same
+// signal this file already keys system-process detection off of below), so
+// a shell that knows which target it is waiting for can register a token
+// here instead, matched by that argv entry rather than by process ancestry.
+static std::map<BString, U32> boxedwinePendingExecTokens;
+
 static bool isValidApplicationPath(const char* path, U32 length) {
     if (!path || !length || length > 240) return false;
     if (path[0] == '/' || path[0] == '\\') return false;
@@ -65,6 +77,31 @@ extern "C" EMSCRIPTEN_KEEPALIVE U32 boxedwine_launch_process(const char* path, U
     return 1;
 }
 
+// A wrapper the shell already knows how to launch (see boxedwine_launch_process)
+// may itself CreateProcessW a further target that never appears in the process
+// tree; call this once per launch with just that target's filename (e.g.
+// "sol.exe") to have it registered under the same token when Wine execve()s it.
+extern "C" EMSCRIPTEN_KEEPALIVE U32 boxedwine_expect_exec(const char* filename, U32 length, U32 launchToken) {
+    if (!isValidApplicationPath(filename, length) || !launchToken) return 0;
+    BString key;
+    for (U32 i = 0; i < length; ++i) {
+        key.append(filename[i]);
+    }
+    boxedwinePendingExecTokens[key] = launchToken;
+    return 1;
+}
+
+U32 boxedwineConsumeExpectedExecToken(const BString& arg) {
+    for (auto it = boxedwinePendingExecTokens.begin(); it != boxedwinePendingExecTokens.end(); ++it) {
+        if (arg.endsWith(it->first, true)) {
+            U32 token = it->second;
+            boxedwinePendingExecTokens.erase(it);
+            return token;
+        }
+    }
+    return 0;
+}
+
 extern "C" EMSCRIPTEN_KEEPALIVE U32 boxedwine_launch_result() {
     return launchResult;
 }
