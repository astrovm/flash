+static bool isValidApplicationPath(const char* path, U32 length) {
+    if (!path || !length || length > 240) return false;
+    if (path[0] == '/' || path[0] == '\\') return false;
+    bool previousDot = false;
+    for (U32 i = 0; i < length; ++i) {
+        const char value = path[i];
+        const bool valid = (value >= 'a' && value <= 'z') ||
+            (value >= 'A' && value <= 'Z') || (value >= '0' && value <= '9') ||
+            value == '/' || value == '-' || value == '_' || value == ' ' || value == '.';
+        if (!valid || (value == '.' && previousDot)) return false;
+        previousDot = value == '.';
+    }
+    return length > 4 && path[length - 4] == '.' &&
+        (path[length - 3] == 'e' || path[length - 3] == 'E') &&
+        (path[length - 2] == 'x' || path[length - 2] == 'X') &&
+        (path[length - 1] == 'e' || path[length - 1] == 'E');
+}
+
+EM_JS(void, boxedwineProcessEvent, (const char* type, U32 processId, U32 parentProcessId, U32 launchToken, const char* executable), {
+    window.dispatchEvent(new CustomEvent("boxedwine-native-process", {
+        detail: { type: UTF8ToString(type), processId, parentProcessId, launchToken, executable: UTF8ToString(executable) },
+    }));
+});
+
+extern "C" EMSCRIPTEN_KEEPALIVE U32 boxedwine_launch_process(const char* path, U32 length, U32 launchToken) {
+    if (!isValidApplicationPath(path, length) || !launchToken || pendingApplication.length()) return 0;
+    launchResult = 0;
+    pendingLaunchToken = launchToken;
+    pendingApplication = B("C:\\files\\");
+    for (U32 i = 0; i < length; ++i) {
+        pendingApplication.append(path[i] == '/' ? '\\' : path[i]);
+    }
+    return 1;
+}
+
+extern "C" EMSCRIPTEN_KEEPALIVE U32 boxedwine_launch_result() {
+    return launchResult;
+}
+
+extern "C" EMSCRIPTEN_KEEPALIVE U32 boxedwine_terminate_process(U32 processId) {
+    if (!processId || pendingTermination) return 0;
+    pendingTermination = processId;
+    return 1;
+}
+
+extern "C" EMSCRIPTEN_KEEPALIVE U32 boxedwine_process_running(U32 processId) {
+    KProcessPtr process = KSystem::getProcess(processId);
+    return process && !process->isTerminated();
+}
+
+static void applyPendingProcessChanges() {
+    if (pendingTermination) {
+        KProcessPtr process = KSystem::getProcess(pendingTermination);
+        if (process && !process->isTerminated()) process->signalProcess(9);
+        pendingTermination = 0;
+    }
+    if (!pendingApplication.length()) return;
+    BString executable = pendingApplication;
+    pendingApplication = BString::empty;
+    U32 launchToken = pendingLaunchToken;
+    pendingLaunchToken = 0;
+    std::vector<BString> args = {B("/bin/wine"), executable};
+    std::vector<BString> environment = {
+        B("HOME=/home/username"), B("LOGNAME=username"), B("USERNAME=username"),
+        B("USER=username"), B("PWD=/home/username/.wine/dosdevices/c:/files"),
+        B("DISPLAY=:0"), B("WINE_FAKE_WAIT_VBLANK=60"),
+        B("PATH=/bin:/usr/bin:/usr/local/bin")};
+    KProcessPtr process = KProcess::create();
+    KThread* thread = process->startProcess(
+        B("/home/username/.wine/dosdevices/c:/files"), args, environment,
+        UID, GID, UID, GID);
+    launchResult = thread ? process->id : 0xffffffff;
+    if (thread) {
+        boxedwineNativeRegisterLaunch(process->id, launchToken);
+        boxedwineProcessEvent("started", process->id, process->parentId,
+            launchToken, executable.c_str());
+    }
+}
