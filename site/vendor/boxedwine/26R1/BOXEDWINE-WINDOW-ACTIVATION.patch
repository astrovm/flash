+    XWindowPtr window = server->getWindow(id);
+    if (!window) {
+        return;
+    }
+    XWindowChanges changes = {};
+    changes.stack_mode = 0;
+    window->configure(CWStackMode, &changes);
+    server->setInputFocus(nullptr, id, 0, 0);
+    window->setDirty();
+}
