+static U32 pendingScreenWidth;
+static U32 pendingScreenHeight;
+
+extern "C" EMSCRIPTEN_KEEPALIVE void boxedwine_resize_screen(U32 width, U32 height) {
+    pendingScreenWidth = width;
+    pendingScreenHeight = height;
+}
+
+static void applyPendingScreenResize() {
+    if (!pendingScreenWidth || !pendingScreenHeight) {
+        return;
+    }
+    XServer* server = XServer::getServer(true);
+    if (!server) {
+        return;
+    }
+    server->changeScreen(pendingScreenWidth, pendingScreenHeight);
+    pendingScreenWidth = 0;
+    pendingScreenHeight = 0;
+}
 
