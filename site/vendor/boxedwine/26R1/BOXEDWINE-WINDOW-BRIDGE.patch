diff --git a/platform/sdl/knativewindowbridge.cpp b/platform/sdl/knativewindowbridge.cpp
new file mode 100644
index 0000000..faadc6d
--- /dev/null
+++ b/platform/sdl/knativewindowbridge.cpp
@@ -0,0 +1,92 @@
+#include "boxedwine.h"
+#include "knativewindowbridge.h"
+#include "../../source/x11/x11.h"
+
+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+
+EM_JS(void, boxedwineWindowLifecycle, (const char* type, U32 id, U32 parentId, S32 x, S32 y, U32 width, U32 height), {
+    window.dispatchEvent(new CustomEvent("boxedwine-native-window", {
+        detail: {
+            type: UTF8ToString(type),
+            id,
+            parentId,
+            x,
+            y,
+            width,
+            height,
+        },
+    }));
+});
+
+EM_JS(void, boxedwineWindowTitle, (U32 id, const U8* value, U32 length), {
+    const bytes = HEAPU8.slice(value, value + length);
+    window.dispatchEvent(new CustomEvent("boxedwine-native-window", {
+        detail: {
+            type: "title",
+            id,
+            title: new TextDecoder("windows-1252").decode(bytes).split(String.fromCharCode(0), 1)[0],
+        },
+    }));
+});
+
+EM_JS(void, boxedwineWindowFrame, (U32 id, const U8* source, U32 pitch, U32 width, U32 height), {
+    const rgba = new Uint8ClampedArray(width * height * 4);
+    for (let y = 0; y < height; y++) {
+        let src = source + y * pitch;
+        let dst = y * width * 4;
+        for (let x = 0; x < width; x++, src += 4, dst += 4) {
+            rgba[dst] = HEAPU8[src + 2];
+            rgba[dst + 1] = HEAPU8[src + 1];
+            rgba[dst + 2] = HEAPU8[src];
+            rgba[dst + 3] = 255;
+        }
+    }
+    window.dispatchEvent(new CustomEvent("boxedwine-native-window", {
+        detail: { type: "frame", id, width, height, rgba },
+    }));
+});
+#endif
+
+static void lifecycle(const char* type, const std::shared_ptr<XWindow>& wnd) {
+#ifdef __EMSCRIPTEN__
+    XWindowPtr parent = wnd->getParent();
+    boxedwineWindowLifecycle(type, wnd->id, parent ? parent->id : 0, wnd->getLeft(), wnd->getTop(), wnd->width(), wnd->height());
+#endif
+}
+
+void boxedwineNativeWindowCreated(const std::shared_ptr<XWindow>& wnd) {
+    lifecycle("created", wnd);
+}
+
+void boxedwineNativeWindowDestroyed(U32 id) {
+#ifdef __EMSCRIPTEN__
+    boxedwineWindowLifecycle("destroyed", id, 0, 0, 0, 0, 0);
+#endif
+}
+
+void boxedwineNativeWindowMapped(const std::shared_ptr<XWindow>& wnd, bool mapped) {
+    lifecycle(mapped ? "mapped" : "unmapped", wnd);
+}
+
+void boxedwineNativeWindowBounds(const std::shared_ptr<XWindow>& wnd) {
+    lifecycle("bounds", wnd);
+}
+
+void boxedwineNativeWindowTitle(U32 id, const U8* value, U32 length) {
+#ifdef __EMSCRIPTEN__
+    boxedwineWindowTitle(id, value, length);
+#endif
+}
+
+void boxedwineNativeWindowOwner(U32 id, U32 ownerId) {
+#ifdef __EMSCRIPTEN__
+    boxedwineWindowLifecycle("owner", id, ownerId, 0, 0, 0, 0);
+#endif
+}
+
+void boxedwineNativeWindowFrame(U32 id, const U8* pixels, U32 pitch, U32 width, U32 height) {
+#ifdef __EMSCRIPTEN__
+    boxedwineWindowFrame(id, pixels, pitch, width, height);
+#endif
+}
